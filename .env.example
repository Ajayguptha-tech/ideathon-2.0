# ========================================================
# IDEATHON 2.0 - PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================
# Safe placeholder configuration file. Copy to .env and fill in real values.
# NEVER commit .env or real credentials to Git or release ZIP archives.

# --------------------------------------------------------
# 1. SERVER CONFIGURATION
# --------------------------------------------------------
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (Primary Storage)
# --------------------------------------------------------
# Find these in your Supabase Project Settings -> API & Database:
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role secret key for backend server access (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional direct Postgres connection string:
# DATABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres

# --------------------------------------------------------
# 3. ADMINISTRATOR AUTHENTICATION (Password-based)
# --------------------------------------------------------
# Authorized administrator email (Strictly one authorized account):
ADMIN_EMAIL=ajayguptha710@gmail.com
# Secure bcrypt hash of admin password (run: node server/generate_hash.js "YourPassword"):
ADMIN_PASSWORD_HASH=$2b$10$QviZH7Is0WSG4ymkS4tcteJFnPT0ozcuwyDU.1g4z5fYyaaT98Riy
# Secret string for signing admin session tokens:
ADMIN_SECRET=generate_a_random_32_character_secret_string_here

# --------------------------------------------------------
# 4. EMAIL CONFIRMATION SERVICE (BREVO / SMTP)
# --------------------------------------------------------
# Brevo SMTP Relay configuration:
# Host: smtp-relay.brevo.com
# Port: 587
# SMTP_USER: Your Brevo login email address (REQUIRED by Brevo SMTP)
# SMTP_PASS: Your Brevo SMTP key or password
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_account_email@domain.com
SMTP_PASS=your_smtp_password_or_key_here
SMTP_FROM_EMAIL=ideathon2026@yic-club.org
SMTP_FROM_NAME="Young Innovators Club Ideathon 2.0"

# Optional: Brevo REST API v3 key (starts with xkeysib-)
# BREVO_API_KEY=your_brevo_api_key_here

# Set to true to test locally without connecting to external SMTP
SIMULATE_EMAIL=false

# --------------------------------------------------------
# 5. GOOGLE SHEETS ASYNC BACKUP (Optional Secondary Sync)
# --------------------------------------------------------
GOOGLE_SHEET_WEBHOOK_URL=

# --------------------------------------------------------
# 6. RATE LIMITING & SECURITY
# --------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=60
