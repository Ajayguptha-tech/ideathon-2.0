# ==============================================================================
# IDEATHON 2.0 — PRODUCTION ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================
# This template documents all variables required for production deployment.
# Copy to .env for local testing or set in your cloud provider's dashboard.
# NEVER commit .env or real secrets to Git.
# ==============================================================================

# ==============================================================================
# PART A: FRONTEND ENVIRONMENT VARIABLES (Vercel / Cloudflare / Static Hosting)
# ==============================================================================
# Set this in your frontend hosting dashboard (e.g., Vercel -> Project Settings -> Environment Variables)
# In development, leave blank to use the Vite proxy (http://localhost:5000).
# In production, set to your deployed backend URL:
VITE_API_URL=https://your-backend-service.onrender.com

# ==============================================================================
# PART B: BACKEND ENVIRONMENT SECRETS (Render / Railway / Web Service)
# ==============================================================================
# Set these in your backend hosting dashboard (e.g., Render -> Environment Variables)

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORKING
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# URL of your deployed frontend (used for CORS origin restriction):
FRONTEND_URL=https://your-frontend-app.vercel.app

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE (Primary Production Storage)
# ------------------------------------------------------------------------------
# Obtain from Neon Console (Dashboard -> Connection Details -> Pooled connection)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:YOUR_ROTATED_PASSWORD@ep-snowy-resonance-b5hd1439-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ------------------------------------------------------------------------------
# 3. ADMINISTRATOR AUTHENTICATION
# ------------------------------------------------------------------------------
# Authorized administrator email (Strict single-account access):
ADMIN_EMAIL=ajayguptha710@gmail.com
# Secure bcrypt hash of admin password:
ADMIN_PASSWORD_HASH=$2b$10$QviZH7Is0WSG4ymkS4tcteJFnPT0ozcuwyDU.1g4z5fYyaaT98Riy
# Random 32+ character secret string for signing admin session tokens (JWT):
ADMIN_SECRET=generate_a_random_32_character_secret_string_here

# ------------------------------------------------------------------------------
# 4. EMAIL CONFIRMATION SERVICE (Brevo / SMTP Relay)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_account_email@domain.com
SMTP_PASS=your_smtp_password_or_key_here
SMTP_FROM_EMAIL=ajayguptha710@gmail.com
SMTP_FROM_NAME="Young Innovators Club Ideathon 2.0"
# Set to false in production to send real emails:
SIMULATE_EMAIL=false

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS ASYNC BACKUP (Optional Secondary Sync)
# ------------------------------------------------------------------------------
GOOGLE_SHEET_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY THROTTLING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=60
